# Names only; Container Apps sets the values (infra/bicep/apps/main.bicep). Local run: ADAPTERS=fake.
ADAPTERS=
TENANT_ID=
CLIENT_ID=
AZURE_CLIENT_ID=
# App IDs allowed to create drafts (the action agent) and to list and decide (apps people use).
DRAFT_CALLERS=
REVIEW_CALLERS=
# north:<group id>,center:<group id>,south:<group id>,directors:<group id>
REGION_GROUPS=
SQL_SERVER=
SQL_DATABASE=
TABLE_ENDPOINT=
TABLE_NAME=
# Exact browser origins (the web app), comma-separated.
ALLOWED_ORIGINS=
# Optional (D-043): Application Insights connection string; traces export with AZURE_CLIENT_ID's
# managed identity. Unset: the service runs untraced.
APPLICATIONINSIGHTS_CONNECTION_STRING=
